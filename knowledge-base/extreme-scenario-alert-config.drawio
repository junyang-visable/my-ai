        <!-- ============ Part 二：Datadog E1-E4 ============ -->
        <mxCell id="p2-bar" value="二、Datadog 极端规则 · E1–E4 × 9 服务（现有同类已发布 0 条，唯一无流量规则 316500818 卡在 draft）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#fff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="443" width="880" height="28" as="geometry" />
