        <mxCell id="t1" value="&lt;table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:9px;width:100%;table-layout:fixed;'&gt;&lt;tr style='background:#b85450;color:#fff;font-weight:bold;'&gt;&lt;td style='width:30px;'&gt;#&lt;/td&gt;&lt;td style='width:95px;'&gt;项目&lt;/td&gt;&lt;td style='width:118px;'&gt;事件类型&lt;/td&gt;&lt;td style='width:78px;'&gt;阈值/5m&lt;/td&gt;&lt;td style='width:78px;'&gt;30天最大&lt;/td&gt;&lt;td style='width:52px;'&gt;p99.9&lt;/td&gt;&lt;td style='width:299px;'&gt;校准备注（30 天 · 5m 分桶 · 生产 error）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;&lt;b&gt;search&lt;/b&gt;&lt;/td&gt;&lt;td&gt;white_screen&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;80&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;123&lt;/td&gt;&lt;td style='text-align:center;'&gt;101&lt;/td&gt;&lt;td&gt;非事故日 ≤40；08-07 真实事故（123）为预期唯一触发&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;search&lt;/td&gt;&lt;td&gt;ssr_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;10&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;2&lt;/td&gt;&lt;td style='text-align:center;'&gt;2&lt;/td&gt;&lt;td&gt;30 天仅 3 个非零窗口，极端稀疏&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;search&lt;/td&gt;&lt;td&gt;custom_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;20&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;4&lt;/td&gt;&lt;td style='text-align:center;'&gt;4&lt;/td&gt;&lt;td&gt;780 个非零窗口，但量级 ≤4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;search&lt;/td&gt;&lt;td&gt;component_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;60&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;—&lt;/td&gt;&lt;td style='text-align:center;'&gt;—&lt;/td&gt;&lt;td&gt;30 天无生产 error 数据，参考 homepage 取 60&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;&lt;b&gt;homepage&lt;/b&gt;&lt;/td&gt;&lt;td&gt;white_screen&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;30&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;17&lt;/td&gt;&lt;td style='text-align:center;'&gt;16&lt;/td&gt;&lt;td&gt;1998 个非零窗口，但量级低&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;homepage&lt;/td&gt;&lt;td&gt;ssr_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;15&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;8&lt;/td&gt;&lt;td style='text-align:center;'&gt;8&lt;/td&gt;&lt;td&gt;56 个非零窗口&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;homepage&lt;/td&gt;&lt;td&gt;custom_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;15&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;2&lt;/td&gt;&lt;td style='text-align:center;'&gt;2&lt;/td&gt;&lt;td&gt;173 个非零窗口，量级 ≤2&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;homepage&lt;/td&gt;&lt;td&gt;component_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;60&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;41&lt;/td&gt;&lt;td style='text-align:center;'&gt;41&lt;/td&gt;&lt;td&gt;三尖峰 41/32/30 均低于阈值，事故日不误报&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;&lt;b&gt;product-editor&lt;/b&gt;&lt;/td&gt;&lt;td&gt;white_screen&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;15&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;8&lt;/td&gt;&lt;td style='text-align:center;'&gt;8&lt;/td&gt;&lt;td&gt;365 个非零窗口&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;product-editor&lt;/td&gt;&lt;td&gt;ssr_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;10&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;6&lt;/td&gt;&lt;td style='text-align:center;'&gt;6&lt;/td&gt;&lt;td&gt;51 个非零窗口&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;product-editor&lt;/td&gt;&lt;td&gt;custom_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;50&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;35&lt;/td&gt;&lt;td style='text-align:center;'&gt;35&lt;/td&gt;&lt;td&gt;尖峰 35（08-10）低于阈值 50&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;product-editor&lt;/td&gt;&lt;td&gt;component_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;&lt;font color='#b85450'&gt;5&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;1&lt;/td&gt;&lt;td style='text-align:center;'&gt;1&lt;/td&gt;&lt;td&gt;30 天仅 3 个非零窗口&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;" vertex="1" parent="1">
