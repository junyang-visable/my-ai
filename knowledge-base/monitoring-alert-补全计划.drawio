        <mxCell id='title' value="线上监控告警补全计划（V-Frontend-Monitor）" style='text;html=1;fontSize=20;fontStyle=1;align=center;' vertex='1' parent='1'><mxGeometry x='20' y='10' width='1360' height='30' as='geometry'/></mxCell>
        <mxCell id='subtitle' value="基于告警能力清单（基线 2026-08-26）逐项盘点 · 新建 75 条 + 清理 8 条 · 标准模板完整度 26/102（25%）→ 102/102（100%）" style='text;html=1;fontSize=10;align=center;fontColor=#666666;' vertex='1' parent='1'><mxGeometry x='20' y='44' width='1360' height='16' as='geometry'/></mxCell>
        <mxCell id='legend-box' value="" style='rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;' vertex='1' parent='1'><mxGeometry x='780' y='68' width='600' height='24' as='geometry'/></mxCell>
        <mxCell id='legend-txt' value="图例：绿格 ✅ = 已有告警 · 红格 / 红底行 ❌ = 无告警（待补）· 灰格 ❌* / 灰底行 = SDK 接入待确认 · 表内链接：⌘/Ctrl + 点击" style='text;html=1;fontSize=9;fontColor=#333333;align=center;verticalAlign=middle;' vertex='1' parent='1'><mxGeometry x='780' y='68' width='600' height='24' as='geometry'/></mxCell>
        <mxCell id='bar1' value="一、Stability SDK 事件类型 vs Sunfire 告警覆盖" style='rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=12;' vertex='1' parent='1'><mxGeometry x='20' y='106' width='1360' height='30' as='geometry'/></mxCell>
        <mxCell id='note1' value="SDK 采集 6 类错误事件至 ODPS，Sunfire 仅对其中 4 类建了告警 —— api_error 与 script_error 在告警层完全裸奔。" style='text;html=1;fontSize=9;fontColor=#666666;align=left;' vertex='1' parent='1'><mxGeometry x='20' y='142' width='1360' height='14' as='geometry'/></mxCell>
        <mxCell id='t1' value="&lt;table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:9px;width:100%;table-layout:fixed;'&gt;&lt;tr style='background:#b85450;color:#fff;font-weight:bold;'&gt;&lt;td style='width:150px;'&gt;event_type&lt;/td&gt;&lt;td style='width:480px;'&gt;说明&lt;/td&gt;&lt;td style='width:110px;'&gt;ODPS 落库&lt;/td&gt;&lt;td style='width:260px;'&gt;Sunfire 告警现状&lt;/td&gt;&lt;td style='width:270px;'&gt;补全计划&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;white_screen&lt;/td&gt;&lt;td&gt;客户端 / SSR 白屏&lt;/td&gt;&lt;td style='text-align:center;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;'&gt;✅ 仅 3 项目有&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;6 项目待建：S-07、S-13/19/25/31/37&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='word-break:break-all;'&gt;ssr_error&lt;/td&gt;&lt;td&gt;SSR 渲染错误&lt;/td&gt;&lt;td style='text-align:center;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;'&gt;✅ 仅 3 项目有&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;6 项目待建：S-08、S-14/20/26/32/38&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;custom_error&lt;/td&gt;&lt;td&gt;业务自定义错误&lt;/td&gt;&lt;td style='text-align:center;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;'&gt;✅ 仅 3 项目有&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;6 项目待建：S-09、S-15/21/27/33/39&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='word-break:break-all;'&gt;component_error&lt;/td&gt;&lt;td&gt;组件渲染错误&lt;/td&gt;&lt;td style='text-align:center;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;'&gt;✅ 仅 3 项目有&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;6 项目待建：S-10、S-16/22/28/34/40&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8cecc;'&gt;&lt;td style='word-break:break-all;'&gt;&lt;b&gt;api_error&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;客户端 API 失败（4xx / 5xx / 网络 / 超时）&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;❌ 全部 9 项目无告警&lt;/b&gt;&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;&lt;b&gt;9 项目全建：S-01/03/05/11、S-17/23/29/35/41&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8cecc;'&gt;&lt;td style='word-break:break-all;'&gt;&lt;b&gt;script_error&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;JS 运行时错误 / 资源加载失败&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;❌ 全部 9 项目无告警&lt;/b&gt;&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;&lt;b&gt;9 项目全建：S-02/04/06/12、S-18/24/30/36/42&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style='rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;' vertex='1' parent='1'><mxGeometry x='20' y='162' width='1360' height='144' as='geometry'/></mxCell>
        <mxCell id='foot1' value="api_slow 已明确排除在监控范围外，不纳入告警。" style='text;html=1;fontSize=9;fontColor=#666666;align=left;' vertex='1' parent='1'><mxGeometry x='20' y='312' width='1360' height='14' as='geometry'/></mxCell>
        <mxCell id='bar2' value="二、项目 × 平台告警现状矩阵" style='rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=12;' vertex='1' parent='1'><mxGeometry x='20' y='340' width='1360' height='30' as='geometry'/></mxCell>
        <mxCell id='note2' value="9 个前端项目 × 2 平台。前 4 类 Sunfire 告警仅覆盖 3 个核心项目；api_error / script_error 全线无告警。Datadog 列数字 = 现有活跃规则数。" style='text;html=1;fontSize=9;fontColor=#666666;align=left;' vertex='1' parent='1'><mxGeometry x='20' y='376' width='1360' height='14' as='geometry'/></mxCell>
        <mxCell id='t2' value="&lt;table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:9px;width:100%;table-layout:fixed;'&gt;&lt;tr style='background:#1565C0;color:#fff;font-weight:bold;'&gt;&lt;td rowspan='2' style='width:260px;'&gt;项目&lt;/td&gt;&lt;td colspan='6'&gt;Sunfire 告警（Stability SDK 事件类型）&lt;/td&gt;&lt;td rowspan='2' style='width:170px;'&gt;Datadog&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1565C0;color:#fff;font-weight:bold;'&gt;&lt;td style='width:130px;'&gt;白屏&lt;/td&gt;&lt;td style='width:130px;'&gt;SSR&lt;/td&gt;&lt;td style='width:130px;'&gt;自定义&lt;/td&gt;&lt;td style='width:130px;'&gt;组件&lt;/td&gt;&lt;td style='width:130px;'&gt;API 错误&lt;/td&gt;&lt;td style='width:130px;'&gt;脚本错误&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;&lt;b&gt;search-frontend&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;background:#d5e8d4;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;background:#d5e8d4;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;background:#d5e8d4;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;background:#d5e8d4;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;background:#f8cecc;'&gt;❌&lt;/td&gt;&lt;td style='text-align:center;background:#f8cecc;'&gt;❌&lt;/td&gt;&lt;td style='text-align:center;background:#d5e8d4;'&gt;✅ 6 条&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;&lt;b&gt;homepage-frontend&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;background:#d5e8d4;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;background:#d5e8d4;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;background:#d5e8d4;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;background:#d5e8d4;'&gt;✅&lt;/td&gt;&lt;td style='text-align:center;background:#f8cecc;'&gt;❌&lt;/td&gt;&lt;td style='text-align:center;background:#f8cecc;'&gt;❌&lt;/td&gt;&lt;td style='text-align:center;background:#d5e8d4;'&gt;✅ 5 条&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;&lt;b