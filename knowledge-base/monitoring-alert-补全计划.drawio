        <mxCell id='s1' value="&lt;div style='text-align:center;font-size:12px;font-weight:bold;margin-bottom:2px;'&gt;Sprint 1 · ~1 周&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;margin-bottom:4px;'&gt;消除零告警盲区&lt;/div&gt;&lt;hr style='margin:2px 0;'&gt;&lt;div style='font-size:9px;text-align:left;'&gt;&lt;b&gt;D-01 ~ D-06&lt;/b&gt; — product-editor Datadog 全套 6 条新建&lt;br&gt;&lt;b&gt;S-01 ~ S-06&lt;/b&gt; — 现有 3 项目补 Sunfire api_error + script_error（6 条）&lt;/div&gt;" style='rounded=1;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;spacingLeft=8;spacingTop=6;' vertex='1' parent='1'><mxGeometry x='20' y='2115' width='320' height='103' as='geometry'/></mxCell>
        <mxCell id='s2' value="&lt;div style='text-align:center;font-size:12px;font-weight:bold;margin-bottom:2px;'&gt;Sprint 2 · ~1 周&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;margin-bottom:4px;'&gt;补齐核心 4 项目双平台对称&lt;/div&gt;&lt;hr style='margin:2px 0;'&gt;&lt;div style='font-size:9px;text-align:left;'&gt;&lt;b&gt;S-07 ~ S-12&lt;/b&gt; — unified-search Sunfire 全 6 类新建&lt;br&gt;&lt;b&gt;D-07 ~ D-08&lt;/b&gt; — unified-search Datadog CPU / Memory&lt;br&gt;&lt;b&gt;D-09&lt;/b&gt; — homepage Datadog SSR 渲染错误&lt;br&gt;&lt;b&gt;R-01 ~ R-03&lt;/b&gt; — unified-search 旧规则退役&lt;/div&gt;" style='rounded=1;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=8;spacingTop=6;' vertex='1' parent='1'><mxGeometry x='366' y='2115' width='320' height='103' as='geometry'/></mxCell>
        <mxCell id='s3' value="&lt;div style='text-align:center;font-size:12px;font-weight:bold;margin-bottom:2px;'&gt;Sprint 3 · ~2 周&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;margin-bottom:4px;'&gt;扩展项目覆盖&lt;/div&gt;&lt;hr style='margin:2px 0;'&gt;&lt;div style='font-size:9px;text-align:left;'&gt;前置：盘点 5 个扩展项目 SDK 接入状态&lt;br&gt;&lt;b&gt;S-13 ~ S-42&lt;/b&gt; — 扩展项目 Sunfire 全 6 类（已接入先行）&lt;br&gt;&lt;b&gt;D-12 ~ D-35&lt;/b&gt; — 4 个扩展项目 Datadog 全套（24 条）&lt;br&gt;&lt;b&gt;R-04&lt;/b&gt; — v-content-generator 重复规则清理&lt;br&gt;&lt;font color='#999999' style='font-size:8px;'&gt;company-overview 未接入 Datadog，跳过（D-10/11 不建）&lt;/font&gt;&lt;/div&gt;" style='rounded=1;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;spacingLeft=8;spacingTop=6;' vertex='1' parent='1'><mxGeometry x='712' y='2115' width='320' height='103' as='geometry'/></mxCell>
        <mxCell id='s4' value="&lt;div style='text-align:center;font-size:12px;font-weight:bold;margin-bottom:2px;'&gt;后续 · 上线后 1–2 周&lt;/div&gt;&lt;div style='text-align:center;font-size:10px;margin-bottom:4px;'&gt;阈值校准&lt;/div&gt;&lt;hr style='margin:2px 0;'&gt;&lt;div style='font-size:9px;text-align:left;'&gt;api_error / script_error 的 delta 阈值按项目流量校准&lt;br&gt;script_error 优先 wow_delta_5m（同比）避免常态高基线误报&lt;br&gt;高价值接口单独建 is_critical 低阈值告警&lt;/div&gt;" style='rounded=1;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;fillColor=#e6e6e6;strokeColor=#999999;spacingLeft=8;spacingTop=6;' vertex='1' parent='1'><mxGeometry x='1058' y='2115' width='320' height='103' as='geometry'/></mxCell>
        <mxCell id='arr-s1-s2' style='edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;' edge='1' parent='1' source='s1' target='s2'><mxGeometry as='geometry'/></mxCell>
        <mxCell id='arr-s2-s3' style='edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;' edge='1' parent='1' source='s2' target='s3'><mxGeometry as='geometry'/></mxCell>
        <mxCell id='arr-s3-s4' style='edgeStyle=orthogonalEdgeStyle;strokeColor=#1565C0;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;' edge='1' parent='1' source='s3' target='s4'><mxGeometry as='geometry'/></mxCell>
        <mxCell id='bar6' value="六、阈值策略参考（Sunfire 事件 × 推荐策略）" style='rounded=1;whiteSpace=wrap;html=1;fillColor=#00695C;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=12;' vertex='1' parent='1'><mxGeometry x='20' y='2232' width='1360' height='30' as='geometry'/></mxCell>
        <mxCell id='t9' value="&lt;table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:9px;width:100%;table-layout:fixed;'&gt;&lt;tr style='background:#00695C;color:#fff;font-weight:bold;'&gt;&lt;td style='width:170px;'&gt;event_type&lt;/td&gt;&lt;td style='width:140px;'&gt;常态基线&lt;/td&gt;&lt;td style='width:300px;'&gt;推荐告警策略&lt;/td&gt;&lt;td style='width:630px;'&gt;理由&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;white_screen&lt;/td&gt;&lt;td style='text-align:center;'&gt;极低&lt;/td&gt;&lt;td style='text-align:center;'&gt;delta_5m &amp;gt; 10–80&lt;/td&gt;&lt;td&gt;任何白屏都是严重问题&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='word-break:break-all;'&gt;ssr_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;低&lt;/td&gt;&lt;td style='text-align:center;'&gt;delta_5m &amp;gt; 10&lt;/td&gt;&lt;td&gt;SSR 崩溃影响全部用户&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;custom_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;低–中&lt;/td&gt;&lt;td style='text-align:center;'&gt;delta_5m &amp;gt; 5–20&lt;/td&gt;&lt;td&gt;业务语义明确&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='word-break:break-all;'&gt;component_error&lt;/td&gt;&lt;td style='text-align:center;'&gt;低&lt;/td&gt;&lt;td style='text-align:center;'&gt;delta_5m &amp;gt; 5–20&lt;/td&gt;&lt;td&gt;组件级隔离&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8cecc;'&gt;&lt;td style='word-break:break-all;'&gt;&lt;b&gt;api_error&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;高&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;delta_5m &amp;gt; 20–50&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;量大，阈值需按流量校准；可拆 critical 子规则&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8cecc;'&gt;&lt;td style='word-break:break-all;'&gt;&lt;b&gt;script_error&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;最高&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;wow_delta_5m &amp;gt; 30–100&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;基线波动大，用同比（wow）降噪&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style='rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;' vertex='1' parent='1'><mxGeometry x='20' y='2268' width='1360' height='144' as='geometry'/></mxCell>
        <mxCell id='footer' value="数据来源：knowledge-base/monitoring-alert-补全计划.md · Sentry 告警不在本计划范围（客户端错误面已由 Stability SDK → Sunfire 覆盖）" style='text;html=1;fontSize=9;fontColor=#666666;align=center;' vertex='1' parent='1'><mxGeometry x='20' y='2424' width='1360' height='14' as='geometry'/></mxCell>
      </root>
