  <diagram id="monitoring-alert-plan" name="线上监控告警补全计划">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="2478" math="0" shadow="0">
      <root>
        <mxCell id="0" />
