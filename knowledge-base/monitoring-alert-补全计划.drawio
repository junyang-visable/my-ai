        <mxCell id='foot3a' value="可选增强：每个项目可额外建 1 条 critical API 告警（api_error + is_critical='true'，delta_5m &amp;gt; 10），实现关键接口失败快速告警。&lt;br&gt;绿格 = 该项目该类告警已存在（现状见 Part 二）· 灰底行 = SDK 接入待确认。" style='text;html=1;fontSize=9;fontColor=#666666;align=left;' vertex='1' parent='1'><mxGeometry x='20' y='1055' width='1360' height='28' as='geometry'/></mxCell>
        <mxCell id='sub3b' value="3.2 Datadog 告警 — 标准 6 条模板（参照 search-frontend）× 项目套用 · 33 条新建" style='rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;fontColor=#ffffff;fontSize=10;fontStyle=1;align=left;spacingLeft=12;' vertex='1' parent='1'><mxGeometry x='20' y='1093' width='1360' height='24' as='geometry'/></mxCell>
        <mxCell id='t4' value="&lt;table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:9px;width:100%;table-layout:fixed;'&gt;&lt;tr style='background:#E65100;color:#fff;font-weight:bold;'&gt;&lt;td style='width:70px;'&gt;模板&lt;/td&gt;&lt;td style='width:180px;'&gt;告警名&lt;/td&gt;&lt;td style='width:100px;'&gt;类型&lt;/td&gt;&lt;td style='width:560px;'&gt;指标 / 查询（&amp;lt;service&amp;gt; 按项目替换）&lt;/td&gt;&lt;td style='width:270px;'&gt;阈值（critical / warn）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;T1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Memory 使用率超限&lt;/td&gt;&lt;td&gt;query_alert&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;avg(last_5m):aws.ecs.service.memory_utilization.maximum{service:&amp;lt;service&amp;gt;}&lt;/td&gt;&lt;td&gt;critical &amp;gt; 90% · warn &amp;gt; 80%&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;T2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;CPU 使用率超限&lt;/td&gt;&lt;td&gt;query_alert&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;avg(last_5m):aws.ecs.service.cpuutilization.maximum{service:&amp;lt;service&amp;gt;}&lt;/td&gt;&lt;td&gt;critical &amp;gt; 90% · warn &amp;gt; 80%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;T3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;p75 延迟超限&lt;/td&gt;&lt;td&gt;query_alert&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;percentile(last_5m):trace.web.request{env:production, service:&amp;lt;service&amp;gt;, span.kind:server}&lt;/td&gt;&lt;td&gt;critical &amp;gt; 1.2s · warn &amp;gt; 1s&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;T4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Server Errors 过多&lt;/td&gt;&lt;td&gt;query_alert&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;sum(last_5m):trace.web.request.errors{env:production, service:&amp;lt;service&amp;gt;, span.kind:server}.as_count() by http.status_code&lt;/td&gt;&lt;td&gt;critical &amp;gt; 50 · warn &amp;gt; 30&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;T5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;SSR 渲染错误&lt;/td&gt;&lt;td&gt;log_alert&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:&quot;&amp;lt;service&amp;gt;&quot; env:production @errorType:SSRRenderError&lt;/td&gt;&lt;td&gt;5m count &amp;gt; 5 · warn &amp;gt; 3&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;T6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Status:error 日志过多&lt;/td&gt;&lt;td&gt;log_alert&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:&quot;&amp;lt;service&amp;gt;&quot; env:production status:error&lt;/td&gt;&lt;td&gt;5m count &amp;gt; 120 · warn &amp;gt; 80&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style='rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;' vertex='1' parent='1'><mxGeometry x='20' y='1123' width='1360' height='144' as='geometry'/></mxCell>
        <mxCell id='t5' value="&lt;table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:9px;width:100%;table-layout:fixed;'&gt;&lt;tr style='background:#E65100;color:#fff;font-weight:bold;'&gt;&lt;td style='width:250px;'&gt;项目&lt;/td&gt;&lt;td style='width:110px;'&gt;编号&lt;/td&gt;&lt;td style='width:240px;'&gt;套用范围&lt;/td&gt;&lt;td style='width:400px;'&gt;service tag&lt;/td&gt;&lt;td style='width:260px;'&gt;通知&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;product-editor-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;D-01 ~ D-06&lt;/b&gt;&lt;/td&gt;&lt;td&gt;全套 T1 ~ T6&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;visable-dev/product-editor-frontend&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='word-break:break-all;'&gt;unified-search-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;D-07 ~ D-08&lt;/b&gt;&lt;/td&gt;&lt;td&gt;仅 T1 + T2（补基础设施）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;webdevs/unified-search-frontend&lt;/td&gt;&lt;td&gt;钉钉 detailpages&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;homepage-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;D-09&lt;/b&gt;&lt;/td&gt;&lt;td&gt;仅 T5（补 SSR 渲染错误）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;visable-dev/homepage-frontend&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='word-break:break-all;'&gt;business-insights-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;D-12 ~ D-17&lt;/b&gt;&lt;/td&gt;&lt;td&gt;全套 T1 ~ T6&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;business-insights-frontend&lt;/td&gt;&lt;td&gt;Teams pegasus-alerts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;requests-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;D-18 ~ D-23&lt;/b&gt;&lt;/td&gt;&lt;td&gt;全套 T1 ~ T6&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;visable-dev/requests-frontend&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='word-break:break-all;'&gt;visitors-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;D-24 ~ D-29&lt;/b&gt;&lt;/td&gt;&lt;td&gt;全套 T1 ~ T6&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;visable-dev/visitors-frontend&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;conversations-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;D-30 ~ D-35&lt;/b&gt;&lt;/td&gt;&lt;td&gt;全套 T1 ~ T6&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;visable-dev/conversations-frontend&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#fce5cd;'&gt;&lt;td colspan='5'&gt;&lt;b&gt;小计：33 条新建&lt;/b&gt; · company-overview 未接入 Datadog（enabled: false，仅 access logs），跳过不建&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style='rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;' vertex='1' parent='1'><mxGeometry x='20' y='1279' width='1360' height='183' as='geometry'/></mxCell>
        <mxCell id='sub3c' value="3.3 Datadog 旧规则清理 — 3 条退役 + 5 条去重" style='rounded=1;whiteSpace=wrap;html=1;fillColor=#37474F;fontColor=#ffffff;fontSize=10;fontStyle=1;align=left;spacingLeft=12;' vertex='1' parent='1'><mxGeometry x='20' y='1474' width='1360' height='24' as='geometry'/></mxCell>
        <mxCell id='t6' value="&lt;table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:9px;width:100%;table-layout:fixed;'&gt;&lt;tr style='background:#37474F;color:#fff;font-weight:bold;'&gt;&lt;td style='width:55px;'&gt;#&lt;/td&gt;&lt;td style='width:140px;'&gt;项目&lt;/td&gt;&lt;td style='width:160px;'&gt;规则 ID&lt;/td&gt;&lt;td style='width:190px;'&gt;规则名&lt;/td&gt;&lt;td style='width:100px;'&gt;建议&lt;/td&gt;&lt;td style='width:630px;'&gt;理由&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;R-01&lt;/b&gt;&lt;/td&gt;&lt;td&gt;unified-search&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/12236842'&gt;12236842&lt;/a&gt;&lt;/td&gt;&lt;td&gt;全部错误（旧）&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;font color='#b85450'&gt;&lt;b&gt;退役&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;阈值 &amp;gt; 0 过于敏感，新规则 284274411 已替代&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;R-02&lt;/b&gt;&lt;/td&gt;&lt;td&gt;unified-search&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/62945068'&gt;62945068&lt;/a&gt;&lt;/td&gt;&lt;td&gt;5xx 错误（旧）&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;font color='#b85450'&gt;&lt;b&gt;退役&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;新规则 284284046 已替代&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;R-03&lt;/b&gt;&lt;/td&gt;&lt;td&gt;unified-search&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/67123179'&gt;67123179&lt;/a&gt;&lt;/td&gt;&lt;td&gt;Error 消息（旧）&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;font color='#b85450'&gt;&lt;b&gt;退役&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;已被新规则覆盖&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td style='text-align:center;'&gt;&lt;b&gt;R-04&lt;/b&gt;&lt;/td&gt;&lt;td&gt;v-content-generator&lt;/td&gt;&lt;td style=