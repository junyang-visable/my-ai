<mxfile host="app.diagrams.net" modified="2026-08-27T00:00:00.000Z" agent="Qoder" version="24.7.6">
  <diagram id="fe-monitor-alerts" name="各平台监控告警清单">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="2415" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="V-Frontend-Monitor 各平台现有监控告警清单" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Sunfire 12 条 · Sentry 6 条（12 个项目中 6 个已配置）· Datadog 29 条服务告警 + 33 条 Synthetics 拨测 · 数据查询时间 2026-08-26" style="text;html=1;fontSize=10;align=center;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1360" height="16" as="geometry"/></mxCell>
        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="66" width="600" height="24" as="geometry"/></mxCell>
        <mxCell id="legend-txt" value="图例：✅ 活跃 · ⏸️ 已静默 / paused · 灰底行 = 无告警规则 · 链接跳转：⌘/Ctrl + 点击「查看」" style="text;html=1;fontSize=9;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="66" width="600" height="24" as="geometry"/></mxCell>
        <mxCell id="bar1" value="一、Sunfire 监控告警（数据来源：Sunfire 租户 6（ICBU），文件夹 V-Frontend-Monitor）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="note1a" value="能力总览：覆盖 3 个前端项目（Arise = Homepage Frontend · Bamboo = Product Editor · Dolphin = Search Frontend），每个项目监控 4 类错误，共 12 项监控 + 12 条告警规则，均为 critical 级别、全部生效。" style="text;html=1;fontSize=9;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="132" width="1360" height="14" as="geometry"/></mxCell>
        <mxCell id="note1b" value="统一触发逻辑：某类错误的总量，最近 5 分钟与过去 5 分钟的差值超过阈值 → 触发 critical 告警（环比突增检测，错误量平稳时不触发）。检测频率：每分钟一次。通知渠道：以钉钉为主（Dolphin 的 SSR 错误为短信）。" style="text;html=1;fontSize=9;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="148" width="1360" height="14" as="geometry"/></mxCell>
        <mxCell id="t1" value="&lt;table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:9px;width:100%;table-layout:fixed;'&gt;&lt;tr style='background:#b85450;color:#fff;font-weight:bold;'&gt;&lt;td style='width:140px;'&gt;监控项&lt;/td&gt;&lt;td style='width:140px;'&gt;监控指标&lt;/td&gt;&lt;td style='width:225px;'&gt;触发条件&lt;/td&gt;&lt;td style='width:555px;'&gt;过滤项&lt;/td&gt;&lt;td style='width:160px;'&gt;通知&lt;/td&gt;&lt;td style='width:80px;'&gt;查看链接&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8cecc;font-weight:bold;'&gt;&lt;td colspan='6'&gt;Arise（Homepage Frontend）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;白屏&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9886)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 10&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'homepage-frontend' AND event_type = 'white_screen' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9886?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;SSR 渲染错误&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9906)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 10&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'homepage-frontend' AND event_type = 'ssr_error' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9906?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;自定义业务错误&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9907)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 5&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'homepage-frontend' AND event_type = 'custom_error' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9907?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;组件渲染错误&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9912)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 20&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'homepage-frontend' AND event_type = 'component_error' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;钉钉（10 分钟内不重复提醒）&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9912?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8cecc;font-weight:bold;'&gt;&lt;td colspan='6'&gt;Bamboo（Product Editor）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;白屏&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9902)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 10&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'product-editor-frontend' AND event_type = 'white_screen' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9902?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;SSR 渲染错误&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9905)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 10&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'product-editor-frontend' AND event_type = 'ssr_error' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9905?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;自定义业务错误（商品更新接口）※&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9909)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与一周前同期差值）&amp;gt; 50&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'product-editor-frontend' AND event_type = 'custom_error' AND env = 'production' AND level = 'error'（eventName 过滤为 update_failed）&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9909?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;组件渲染错误&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9910)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 5&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'product-editor-frontend' AND event_type = 'component_error' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9910?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f8cecc;font-weight:bold;'&gt;&lt;td colspan='6'&gt;Dolphin（Search Frontend）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;白屏&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9903)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 80&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'search-frontend' AND event_type = 'white_screen' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;钉钉（15 分钟内不重复提醒）&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9903?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;SSR 渲染错误&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9904)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 10&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'search-frontend' AND event_type = 'ssr_error' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;短信&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9904?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;自定义业务错误&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9908)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 20&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'search-frontend' AND event_type = 'custom_error' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9908?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;组件渲染错误&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;SPM count (6_spm_9911)&lt;/td&gt;&lt;td&gt;总量（最近 5 分钟与过去 5 分钟差值）&amp;gt; 5&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;app_name = 'search-frontend' AND event_type = 'component_error' AND env = 'production' AND level = 'error'&lt;/td&gt;&lt;td&gt;钉钉&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://x.alibaba-inc.com/custom/6/product/preview/spm/9911?crossTenant=true'&gt;查看数据&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="166" width="1360" height="331" as="geometry"/></mxCell>
        <mxCell id="foot1" value="※ 唯一例外：Bamboo 的「自定义业务错误（商品更新接口）」对比基线是一周前同期（同比突增检测），额外过滤 eventName = update_failed。数据链路：Stability SDK → POST /web/metrics → icbu_de.s_tt_v_web_metrics_tt4 → ETL → icbu_de.visable_fe_full_monitoring_data_v1 → Sunfire SPM 监控。告警规则统一归属应用 v-search-rec-data-process。" style="text;html=1;fontSize=9;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="503" width="1360" height="26" as="geometry"/></mxCell>
        <mxCell id="bar2" value="二、Sentry 监控告警（数据来源：Sentry SaaS（us.sentry.io），组织 visable-gmbh）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="537" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="note2" value="告警类型为 Issue Alert（基于 issue 优先级触发）。统一触发逻辑：Sentry 将某个 issue 标记为 High Priority（新 issue 或已有 issue 升级为高优先级）→ 触发通知。通知渠道：邮件（Issue Owners，无 Owner 时回退 Active Members），同一规则 30 分钟内不重复。" style="text;html=1;fontSize=9;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="569" width="1360" height="28" as="geometry"/></mxCell>
        <mxCell id="t2" value="&lt;table border='1' cellpadding='4' cellspacing='0' style='border-collapse:collapse;font-size:9px;width:100%;table-layout:fixed;'&gt;&lt;tr style='background:#1565C0;color:#fff;font-weight:bold;'&gt;&lt;td style='width:190px;'&gt;Sentry 项目&lt;/td&gt;&lt;td style='width:170px;'&gt;监控项&lt;/td&gt;&lt;td style='width:220px;'&gt;过滤项&lt;/td&gt;&lt;td style='width:330px;'&gt;通知&lt;/td&gt;&lt;td style='width:90px;'&gt;查看链接&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;search-frontend&lt;/td&gt;&lt;td&gt;高优先级 Issue 告警&lt;/td&gt;&lt;td&gt;排除 source=client 及 source 含 server 的事件&lt;/td&gt;&lt;td&gt;邮件（Issue Owners → Active Members），30 min 不重复&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://visable-gmbh.sentry.io/alerts/rules/search-frontend/15558042/details/'&gt;查看规则&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td colspan='5' style='color:#666;'&gt;✅ 活跃 · 最近触发 2026-08-25 17:23 UTC · 创建 2024-11-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;homepage-frontend&lt;/td&gt;&lt;td&gt;高优先级 Issue 告警&lt;/td&gt;&lt;td&gt;无&lt;/td&gt;&lt;td&gt;邮件（Issue Owners → Active Members），30 min 不重复&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://visable-gmbh.sentry.io/alerts/rules/homepage-frontend/15815255/details/'&gt;查看规则&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td colspan='5' style='color:#666;'&gt;⏸️ 已静默（Snooze for everyone） · 从未触发 · 创建 2025-02-25&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;company-overview&lt;/td&gt;&lt;td&gt;高优先级 Issue 告警&lt;/td&gt;&lt;td&gt;无&lt;/td&gt;&lt;td&gt;邮件（Issue Owners → Active Members），30 min 不重复&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://visable-gmbh.sentry.io/alerts/rules/company-overview/15401031/details/'&gt;查看规则&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td colspan='5' style='color:#666;'&gt;✅ 活跃 · 最近触发 2026-08-22 04:25 UTC · 创建 2024-08-22&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;ad-center-frontend&lt;/td&gt;&lt;td&gt;高优先级 Issue 告警&lt;/td&gt;&lt;td&gt;无&lt;/td&gt;&lt;td&gt;邮件（Issue Owners → Active Members），30 min 不重复&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://visable-gmbh.sentry.io/alerts/rules/ad-center-frontend/15550916/details/'&gt;查看规则&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td colspan='5' style='color:#666;'&gt;✅ 活跃 · 最近触发 2026-08-24 11:44 UTC · 创建 2024-11-05&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;sales-tool-frontend&lt;/td&gt;&lt;td&gt;高优先级 Issue 告警&lt;/td&gt;&lt;td&gt;无&lt;/td&gt;&lt;td&gt;邮件（Issue Owners → Active Members），30 min 不重复&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://visable-gmbh.sentry.io/alerts/rules/sales-tool-frontend/16009398/details/'&gt;查看规则&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td colspan='5' style='color:#666;'&gt;✅ 活跃 · 最近触发 2026-08-25 07:51 UTC · 创建 2025-05-21&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;supplier-onboarding-frontend&lt;/td&gt;&lt;td&gt;新 Issue / 回归 / 频率告警&lt;/td&gt;&lt;td&gt;issue 至少发生 3 次&lt;/td&gt;&lt;td&gt;MS Teams（team.sphinx → Alerts 频道），10 min 不重复&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://visable-gmbh.sentry.io/alerts/rules/supplier-onboarding-frontend/15142955/details/'&gt;查看规则&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#f5f5f5;'&gt;&lt;td colspan='5' style='color:#666;'&gt;✅ 活跃 · production · 最近触发 2026-08-26 08:34 UTC · 创建 2024-04-25 · Owner: team:sphinx&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#e6e6e6;font-weight:bold;'&gt;&lt;td colspan='5'&gt;以下 6 个项目无告警规则（仍在采集错误数据，但不会主动通知）&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#e6e6e6;'&gt;&lt;td colspan='5'&gt;product-editor-frontend · unified-search-frontend · business-insights-frontend · requests-frontend · user-frontend · visitors-frontend&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="601" width="1050" height="300" as="geometry"/></mxCell>
        <mxCell id="bar3" value="三、Datadog 监控告警（数据来源：Datadog SaaS（app.datadoghq.com），组织 ID 231549）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;fontColor=#ffffff;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="931" width="1360" height="30" as="geometry"/></mxCell>
        <mxCell id="note3" value="覆盖 6 个前端服务 + 1 个前端 BFF 服务 + Synthetics 页面拨测，共 55+ 条活跃监控规则。告警类型：Query Alert（指标阈值）、Log Alert（日志计数阈值）、Trace Analytics Alert、Synthetics Alert。" style="text;html=1;fontSize=9;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="963" width="1360" height="28" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;table border='1' cellpadding='3' cellspacing='0' style='border-collapse:collapse;font-size:9px;width:100%;table-layout:fixed;'&gt;&lt;tr style='background:#E65100;color:#fff;font-weight:bold;'&gt;&lt;td style='width:140px;'&gt;监控项&lt;/td&gt;&lt;td style='width:180px;'&gt;监控指标&lt;/td&gt;&lt;td style='width:210px;'&gt;触发条件&lt;/td&gt;&lt;td style='width:530px;'&gt;过滤项&lt;/td&gt;&lt;td style='width:160px;'&gt;通知&lt;/td&gt;&lt;td style='width:80px;'&gt;查看链接&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#fce5cd;font-weight:bold;'&gt;&lt;td colspan='6'&gt;search-frontend（visable-dev/search-frontend · vcn-frontend / dolphin）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;Memory 使用率超限&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;aws.ecs.service.memory_utilization.maximum&lt;/td&gt;&lt;td&gt;avg(last_5m) &amp;gt; 90%（warn &amp;gt; 80%）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;{service:visable-dev/search-frontend}&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/171637218'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;CPU 使用率超限&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;aws.ecs.service.cpuutilization.maximum&lt;/td&gt;&lt;td&gt;avg(last_5m) &amp;gt; 90%（warn &amp;gt; 80%）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;{service:visable-dev/search-frontend}&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/171637260'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;p75 延迟超限&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;trace.web.request (p75)&lt;/td&gt;&lt;td&gt;percentile(last_5m) &amp;gt; 1.2s（warn &amp;gt; 1s），恢复 0.6s / 0.4s&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;{env:production, service:visable-dev/search-frontend, span.kind:server}&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/233667687'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;Server Errors 过多&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;trace.web.request.errors (sum, as_count)&lt;/td&gt;&lt;td&gt;sum(last_5m) by {http.status_code} &amp;gt; 200（warn &amp;gt; 120）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;{env:production, service:visable-dev/search-frontend, span.kind:server}&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/233672283'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;SSR 渲染错误&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;Logs rollup count&lt;/td&gt;&lt;td&gt;last 5m count &amp;gt; 5（warn &amp;gt; 3），恢复 4 / 2&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:&quot;visable-dev/search-frontend&quot; env:production @errorType:SSRRenderError&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/266909627'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;Status:error 日志过多&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;Logs rollup count&lt;/td&gt;&lt;td&gt;last 30m count &amp;gt; 400（warn &amp;gt; 300），恢复 80 / 40&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:&quot;visable-dev/search-frontend&quot; env:production status:error&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/270496383'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ECEFF1;color:#666;'&gt;&lt;td colspan='6'&gt;当前状态：p75 延迟 Alert（持续超 1.2s），其余 OK。&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#fce5cd;font-weight:bold;'&gt;&lt;td colspan='6'&gt;homepage-frontend（visable-dev/homepage-frontend · vcn-frontend / arise）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;Memory 使用率超限&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;aws.ecs.service.memory_utilization.maximum&lt;/td&gt;&lt;td&gt;avg(last_5m) &amp;gt; 90%（warn &amp;gt; 80%）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;{service:visable-dev/homepage-frontend}&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend + arise-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/233667959'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;CPU 使用率超限&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;aws.ecs.service.cpuutilization.maximum&lt;/td&gt;&lt;td&gt;avg(last_5m) &amp;gt; 90%（warn &amp;gt; 80%）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;{service:visable-dev/homepage-frontend}&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend + arise-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/233668208'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;p75 延迟超限&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;trace.web.request (p75)&lt;/td&gt;&lt;td&gt;percentile(last_5m) &amp;gt; 1s（warn &amp;gt; 700ms），恢复 600ms / 400ms&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;{env:production, service:visable-dev/homepage-frontend, span.kind:server}&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend + arise-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/233668367'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;Server Errors 过多&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;trace.web.request.errors (sum, as_count)&lt;/td&gt;&lt;td&gt;sum(last_5m) by {http.status_code} &amp;gt; 50（warn &amp;gt; 30）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;{env:production, service:visable-dev/homepage-frontend, span.kind:server}&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend + arise-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/233671589'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;Status:error 日志过多&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;Logs rollup count&lt;/td&gt;&lt;td&gt;last 5m count &amp;gt; 120（warn &amp;gt; 80），恢复 80 / 40&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:&quot;visable-dev/homepage-frontend&quot; env:production status:error&lt;/td&gt;&lt;td&gt;钉钉 vcn-frontend&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/270555958'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ECEFF1;color:#666;'&gt;&lt;td colspan='6'&gt;当前状态：全部 OK。&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#fce5cd;font-weight:bold;'&gt;&lt;td colspan='6'&gt;unified-search-frontend（webdevs/unified-search-frontend · vcn-frontend / arise / pegasus）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;Status:error 日志过多&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;Logs rollup count&lt;/td&gt;&lt;td&gt;last 5m count &amp;gt; 300（warn &amp;gt; 200）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:&quot;webdevs/unified-search-frontend&quot; status:error env:production&lt;/td&gt;&lt;td&gt;钉钉 detailpages&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/284274411'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;p75 延迟超限&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;trace.web.request (p75)&lt;/td&gt;&lt;td&gt;percentile(last_5m) &amp;gt; 1.2s（warn &amp;gt; 1s）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;{span.kind:server, service:webdevs/unified-search-frontend, env:production}&lt;/td&gt;&lt;td&gt;钉钉 detailpages&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/284280863'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;5xx 错误过多（新）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;Logs rollup count&lt;/td&gt;&lt;td&gt;last 5m count &amp;gt; 12（warn &amp;gt; 8）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:&quot;webdevs/unified-search-frontend&quot; stage:production @status:(&amp;gt;=500 &amp;lt;=599) -@url:(*products/null OR *produkte/null)&lt;/td&gt;&lt;td&gt;钉钉 detailpages&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/284284046'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;全部错误（旧）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;Logs rollup count&lt;/td&gt;&lt;td&gt;last 5m count &amp;gt; 0&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:&quot;webdevs/unified-search-frontend&quot; stage:production status:error&lt;/td&gt;&lt;td&gt;邮件 benjamin.vetter&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/12236842'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;5xx 错误（旧）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;Logs rollup count&lt;/td&gt;&lt;td&gt;last 5m count &amp;gt; 5（warn &amp;gt; 1）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:&quot;webdevs/unified-search-frontend&quot; stage:production @status:(&amp;gt;=500 &amp;lt;=599)&lt;/td&gt;&lt;td&gt;邮件 pegasus 团队&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/62945068'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;Error 消息（旧）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;Logs rollup count&lt;/td&gt;&lt;td&gt;last 5m count &amp;gt; 5（warn &amp;gt; 3）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:&quot;webdevs/unified-search-frontend&quot; stage:production ERROR -api.authenticate -&quot;Proxy error&quot;&lt;/td&gt;&lt;td&gt;邮件 pegasus 团队&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/67123179'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ECEFF1;color:#666;'&gt;&lt;td colspan='6'&gt;当前状态：「全部错误（旧）」Alert，「Error 消息（旧）」Warn，其余 OK。注：前 3 条为 2026 年新建（team:vcn-frontend），后 3 条为早期遗留规则（team:pegasus）。&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#fce5cd;font-weight:bold;'&gt;&lt;td colspan='6'&gt;product-editor-frontend（visable-dev/product-editor-frontend）&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ECEFF1;color:#666;'&gt;&lt;td colspan='6'&gt;当前未配置任何 Datadog 监控告警规则。&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#fce5cd;font-weight:bold;'&gt;&lt;td colspan='6'&gt;supplier/onboarding-frontend（supplier/onboarding-frontend · pegasus）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;Supplier Facts 错误激增&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;Trace Analytics (span count)&lt;/td&gt;&lt;td&gt;last 10m count &amp;gt; 5（warn &amp;gt; 2）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:supplier/onboarding-frontend env:production status:error @http.host:supplier-facts.internal.wlw-1.production.visable.cloud&lt;/td&gt;&lt;td&gt;Teams pegasus-alerts&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/301373193'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='word-break:break-all;'&gt;HTTP 错误响应过多&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;Trace Analytics (span count)&lt;/td&gt;&lt;td&gt;last 15m count &amp;gt; 20（warn &amp;gt; 10）&lt;/td&gt;&lt;td style='word-break:break-all;'&gt;service:supplier/onboarding-frontend env:production @http.status_code:[400 TO 599]&lt;/td&gt;&lt;td&gt;Teams pegasus-alerts&lt;/td&gt;&lt;td style='text-align:center;'&gt;&lt;a href='https://app.datadoghq.com/monitors/301415375'&gt;查看&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ECEFF1;color:#666;'&gt;&lt;td colspan='6'&gt;当前状态：全部 OK。&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#fce5cd;font-weight:bold;'&gt;&lt;td colspan='6