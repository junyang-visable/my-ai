#!/usr/bin/env bash
# =============================================================================
# harness — workspace-mode console for harness-kit
# -----------------------------------------------------------------------------
# Register, switch, and drive any repo from the kit directory; target repos
# need zero installation and receive zero writes. Data model: per-project
# harness data (commands, notes, tasks, evidence) lives in a central
# knowledge base, one tree per project: <kb>/<alias>/{config.sh, notes.md,
# context/, tasks/}. <kb> defaults to the kit's sibling "knowledge-base" dir
# and can be relocated via HARNESS_KB_HOME (useful when distributing the kit).
# The kit itself keeps only a thin repo registry (workspaces/<alias>.conf.sh =
# repo path), the engine/skills, and cross-project playbooks.
#
# Usage:
#   ./harness add <alias> <repo-path>   Register a repo (init <kb>/<alias>/) and activate it
#   ./harness link [skills-dir]         Symlink kit skills into a skills dir (default ../.agents/skills)
#   ./harness use <alias>               Switch the active repo
#   ./harness list                      List registered workspaces
#   ./harness current                   Show the active repo
#   ./harness validate [selfcheck|--strict|--stage X]   Run the unified validation pipeline
#   ./harness lock <update|verify|list> Assertion lock (scope = active repo's smoke set)
#   ./harness evidence <task> [layout|api|render|generic]   Collect failure evidence
#   ./harness task new <name>           Create a task dir (spec/plan/current/result/history/evidence) under <kb>/<alias>/tasks/
#   ./harness task list                 List tasks of the active repo
#   ./harness context                   Print the contract text (paste into agent sessions or save as AGENTS.md)
#   ./harness brief [keywords...]       Kickoff pack: contract + repo notes + matching playbooks + task list
#   ./harness doctor                    Health check for the active workspace
# =============================================================================
set -euo pipefail

KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KB="${HARNESS_KB_HOME:-$(cd "$KIT/.." && pwd)/knowledge-base}"
WS="$KIT/workspaces"
ACTIVE_F="$WS/.active"
ENGINE="$KIT/.harness/feedback"
TPL="$KIT/.harness/tasks/_template"

c_grn=$'\033[32m'; c_dim=$'\033[2m'; c_red=$'\033[31m'; c_rst=$'\033[0m'

die() { echo "${c_red}$*${c_rst}" >&2; exit 1; }

conf_of()   { echo "$WS/$1.conf.sh"; }
active()    { [ -f "$ACTIVE_F" ] && cat "$ACTIVE_F" || return 1; }

require_active() {
  local a; a="$(active)" || die "No active workspace yet. Run: ./harness add <alias> <repo-path>"
  [ -f "$(conf_of "$a")" ] || die "Config for active workspace '$a' is missing: $(conf_of "$a")"
  echo "$a"
}

# Load the active workspace and export engine-facing variables, then exec engine scripts.
load_env() {
  local a="$1" conf repo pdata
  conf="$(conf_of "$a")"
  # shellcheck source=/dev/null
  source "$conf"
  repo="${HARNESS_REPO:-}"
  [ -n "$repo" ] && [ -d "$repo" ] || die "workspace '$a' repo not found: ${repo:-<HARNESS_REPO unset>}"
  pdata="$KB/$a"
  # The project's knowledge-base config carries the commands; source it so
  # doctor/brief see it, and export HARNESS_CONF so engine scripts re-source
  # it over kit defaults.
  if [ -f "$pdata/config.sh" ]; then
    # shellcheck source=/dev/null
    source "$pdata/config.sh"
  fi
  export HARNESS_REPO="$repo"
  export HARNESS_CONF="$pdata/config.sh"
  export HARNESS_TASKS_DIR="$pdata/tasks"
  export HARNESS_LOCK_BASELINE="$pdata/.lock-baseline.json"
  # lock/evidence scripts also need these when invoked directly
  export HARNESS_SMOKE_GLOB="${HARNESS_SMOKE_GLOB:-cypress/e2e/smoke/**/*.cy.*}"
  export HARNESS_E2E_CMD="${HARNESS_E2E_CMD:-}"
  export HARNESS_EVIDENCE_DIR="${HARNESS_EVIDENCE_DIR:-}"
  mkdir -p "$HARNESS_TASKS_DIR"
}

usage() { sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; }

cmd="${1:-}"; shift || true
case "$cmd" in

  add)
    alias="${1:?usage: ./harness add <alias> <repo-path>}"
    repo_path="${2:?usage: ./harness add <alias> <repo-path>}"
    [ -d "$repo_path" ] || die "directory not found: $repo_path"
    repo="$(cd "$repo_path" && pwd)"
    mkdir -p "$WS"
    conf="$(conf_of "$alias")"
    if [ -e "$conf" ]; then die "workspace already exists: $alias ($conf)"; fi
    cat > "$conf" <<EOF
# workspace: $alias — thin registry (repo path + optional env defaults).
# Commands, notes, and tasks live in the knowledge base at $KB/$alias/.
HARNESS_REPO="$repo"
EOF

    # Knowledge-base data home for this project: commands + notes + E2E context
    # (skip if already initialized; the target repo itself is never written)
    pdata="$KB/$alias"
    if [ -e "$pdata" ]; then
      echo "  $pdata already exists — keeping it as is"
    else
      mkdir -p "$pdata/context" "$pdata/tasks"
      cat > "$pdata/config.sh" <<'EOF'
# harness-kit project config — the ONLY file to adapt per stack.
# Commands run via `bash -c`; empty commands are skipped with an info line.
HARNESS_LINT_CMD=""            # e.g. "pnpm -s lint"
HARNESS_TYPECHECK_CMD=""       # e.g. "pnpm -s tsc --noEmit"
HARNESS_BUILD_CMD=""           # e.g. "pnpm -s build" (hard gate for frontends)
HARNESS_TEST_CMD=""            # e.g. "pnpm -s test -- --run"

# Advisory
HARNESS_STYLE_CMD=""

# E2E / smoke set (assertion-lock scope, globs relative to repo root)
HARNESS_E2E_CMD=""             # e.g. "pnpm -s cypress run --spec 'cypress/e2e/smoke/**'"
HARNESS_SMOKE_GLOB="cypress/e2e/smoke/**/*.cy.*"
EOF
      cp "$KIT/.harness/context/testing/e2e-context.md" "$pdata/context/e2e-context.md"
      cat > "$pdata/notes.md" <<NOTES_EOF
# $alias — repo notes

> Stack, verified commands, pitfalls, and conventions for this repo.
> Task-level history lives in tasks/<task>/history.md under this dir;
> cross-repo lessons graduate to the kit's playbooks/.

## Stack & verified commands
- (lint / typecheck / build / test commands that actually work here, plus known quirks)

## Pitfalls & conventions
- (selector conventions, env vars, deployment, landmines to avoid…)
NOTES_EOF
    fi

    echo "$alias" > "$ACTIVE_F"
    echo "${c_grn}Registered and activated workspace: $alias → $repo${c_rst}"
    echo "Next: fill $pdata/config.sh with this repo's commands;"
    echo "      jot stack & pitfalls into $pdata/notes.md;"
    echo "      then run ./harness validate selfcheck to prove the guardrails are real."
    ;;

  link)
    # Symlink kit skills into a skills dir so agent sessions can invoke them
    if [ $# -ge 1 ]; then
      dest="$1"
    elif [ -d "$KIT/../.agents" ]; then
      dest="$KIT/../.agents/skills"
    else
      die "default skills dir not found ($KIT/../.agents/skills). usage: ./harness link <skills-dir>"
    fi
    mkdir -p "$dest"
    dest="$(cd "$dest" && pwd)"
    # Default target (skills dir inside the kit's own repo) gets relative links:
    # they survive clone/machine moves.
    default_dest="$(cd "$KIT/../.agents/skills" 2>/dev/null && pwd || true)"
    kitname="$(basename "$KIT")"
    for srcd in "$KIT"/skills/*/; do
      [ -d "$srcd" ] || continue
      name="$(basename "$srcd")"
      target="$dest/$name"
      if [ -e "$target" ] && [ ! -L "$target" ]; then
        echo "  skip  ${target} (exists and is not a symlink; handle manually if you want it replaced)" >&2
        continue
      fi
      [ -L "$target" ] && rm "$target"
      if [ -n "$default_dest" ] && [ "$dest" = "$default_dest" ]; then
        ln -s "../../$kitname/skills/$name" "$target"
      else
        ln -s "$KIT/skills/$name" "$target"
      fi
      echo "  link  $dest/$name → skills/$name"
    done
    echo "${c_grn}Done. Restart Qoder (or open a new session) for the skills to take effect.${c_rst}"
    ;;

  use)
    alias="${1:?usage: ./harness use <alias>}"
    [ -f "$(conf_of "$alias")" ] || die "no such workspace: $alias (run ./harness add first)"
    echo "$alias" > "$ACTIVE_F"
    echo "switched to ${c_grn}$alias${c_rst}"
    ;;

  list)
    [ -d "$WS" ] || { echo "(no workspaces yet)"; exit 0; }
    cur="$(active || true)"
    found=0
    for f in "$WS"/*.conf.sh; do
      [ -e "$f" ] || continue
      found=1
      a="$(basename "$f" .conf.sh)"
      repo="$(source "$f" 2>/dev/null; echo "${HARNESS_REPO:-?}")"
      mark=" "; [ "$a" = "$cur" ] && mark="*"
      printf "%s %-16s %s\n" "$mark" "$a" "$repo"
    done
    if [ "$found" -eq 0 ]; then echo "(no workspaces yet)"; fi
    ;;

  current)
    a="$(require_active)"; load_env "$a"
    echo "$a → $HARNESS_REPO"
    echo "${c_dim}tasks:    $HARNESS_TASKS_DIR${c_rst}"
    echo "${c_dim}baseline: $HARNESS_LOCK_BASELINE${c_rst}"
    ;;

  validate)
    a="$(require_active)"; load_env "$a"
    exec bash "$ENGINE/validate.sh" "$@"
    ;;

  lock)
    a="$(require_active)"; load_env "$a"
    cd "$HARNESS_REPO"
    exec python3 "$ENGINE/lock-tests.py" "${1:-verify}"
    ;;

  evidence)
    a="$(require_active)"; load_env "$a"
    exec bash "$ENGINE/collect-evidence.sh" "$@"
    ;;

  task)
    sub="${1:?usage: ./harness task new|list <name>}"; shift || true
    a="$(require_active)"; load_env "$a"
    case "$sub" in
      new)
        name="${1:?usage: ./harness task new <name>}"
        dst="$HARNESS_TASKS_DIR/$name"
        [ -e "$dst" ] && die "task already exists: $dst"
        mkdir -p "$dst/evidence"
        cp "$TPL/spec.md" "$TPL/plan.md" "$TPL/current.md" "$TPL/result.md" "$TPL/history.md" "$dst/"
        echo "created task: $dst"
        echo "standard mode (default): harness-spec fills spec.md (confirmed) → harness-plan writes plan.md → coding loop; multi-app specs must cover every involved app."
        echo "minimal mode (only on explicit user request): skip spec/plan, record mode + one-liner in current.md, locate and fix directly; branch + validate guardrails still apply."
        ;;
      list)
        ls -1 "$HARNESS_TASKS_DIR" 2>/dev/null | grep -v '^_template$' || echo "(no tasks)"
        ;;
      *) die "unknown subcommand: task $sub" ;;
    esac
    ;;

  context)
    a="$(require_active)"; load_env "$a"
    echo "# Session opener for agents (or save as AGENTS.md at the repo root)"
    echo
    echo "You are working in $HARNESS_REPO; validation is provided by the external harness-kit:"
    echo "- single validation entry (run from the kit dir): ./harness validate"
    echo "- on completion, file evidence per harness-kit/.harness/rubric/evidence-template.md"
    echo "- red lines: never delete assertions / change test expectations / @ts-ignore your way to green; build cannot be skipped."
    echo "- smoke tests are protected by the assertion lock: ./harness lock verify"
    echo "- repo-specific notes and E2E context: $KB/$a/notes.md and $KB/$a/context/e2e-context.md"
    echo
    echo "${c_dim}Full contract layer: templates/AGENTS.md. To have agents read it every session, copy it to the repo root as AGENTS.md.${c_rst}"
    ;;

  brief)
    # Kickoff pack: contract + repo notes + matching playbooks + task list, in one shot
    a="$(require_active)"; load_env "$a"
    echo "== contract (workspace: ${a}) =="
    echo "repo $HARNESS_REPO | validation: ./harness validate | assertion lock: ./harness lock verify"
    echo "red lines: never delete assertions / change test expectations / @ts-ignore to green; build cannot be skipped."
    echo "evidence template: $KIT/.harness/rubric/evidence-template.md"
    echo
    echo "== repo notes ($KB/$a/notes.md, full text) =="
    cat "$KB/$a/notes.md" 2>/dev/null || echo "(missing)"
    echo
    echo "== E2E context: $KB/$a/context/e2e-context.md (read before acceptance) =="
    echo
    echo "== playbooks (${*:-list all}) =="
    if [ "$#" -eq 0 ]; then
      for f in "$KIT"/playbooks/*.md; do
        [ -f "$f" ] || continue
        b="$(basename "$f")"
        case "$b" in README.md|_template.md) continue ;; esac
        echo "  - $f"
      done
    else
      pat="$(IFS='|'; echo "$*")"
      for f in $(grep -ilE "$pat" "$KIT"/playbooks/*.md 2>/dev/null || true); do
        b="$(basename "$f")"
        case "$b" in README.md|_template.md) continue ;; esac
        echo "  - $f"
      done
    fi
    echo
    echo "== tasks (read current.md first when resuming) =="
    ls -1 "$HARNESS_TASKS_DIR" 2>/dev/null | grep -v '^_template$' || echo "(no tasks)"
    ;;

  doctor)
    a="$(require_active)"; load_env "$a"
    echo "== doctor: $a =="
    echo "repo:     $HARNESS_REPO"
    if git -C "$HARNESS_REPO" rev-parse --git-dir >/dev/null 2>&1; then
      if git -C "$HARNESS_REPO" rev-parse --short HEAD >/dev/null 2>&1; then
        echo "git:      $(git -C "$HARNESS_REPO" rev-parse --short HEAD) @ $(git -C "$HARNESS_REPO" branch --show-current 2>/dev/null || echo '?')"
      else
        echo "git:      (repo initialized, but has no commits yet)"
      fi
    else
      echo "git:      (not a git repo — consider version control)"
    fi
    for v in HARNESS_LINT_CMD HARNESS_TYPECHECK_CMD HARNESS_BUILD_CMD HARNESS_TEST_CMD; do
      if [ -n "${!v:-}" ]; then echo "${c_grn}✓${c_rst} $v = ${!v}"; else echo "${c_dim}○${c_rst} $v unset (stage will be skipped)"; fi
    done
    n=0; for g in $HARNESS_SMOKE_GLOB; do
      base="${g##*/}"
      dir="${g%/*}"; [ "$dir" = "$g" ] && dir="."
      dir="${dir%%\*\**}"                  # strip ** and beyond, keep the leading dir
      dir="${dir%/}"; [ -z "$dir" ] && dir="."
      cnt="$(find "$HARNESS_REPO/$dir" -type f -name "$base" 2>/dev/null | wc -l | tr -d ' ')"
      echo "smoke:    $g → $cnt file(s)"; n=$((n+cnt))
    done
    [ "$n" -eq 0 ] && echo "${c_red}!${c_rst} smoke set is empty: the assertion lock has nothing to protect yet; add cases under cypress/e2e/smoke/"
    [ -f "$HARNESS_LOCK_BASELINE" ] && echo "baseline: present ($HARNESS_LOCK_BASELINE)" || echo "baseline: not established (run ./harness lock update once the smoke set is stable)"
    ;;

  ""|-h|--help|help) usage ;;
  *) die "unknown command: ${cmd} (./harness help)" ;;
esac
